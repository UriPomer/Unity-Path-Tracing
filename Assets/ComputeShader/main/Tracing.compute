#pragma kernel CSMain

#include "function.hlsl"
#include "colors.hlsl"
#include "bxdf.hlsl"
#include "test.hlsl"
#include "trace.hlsl"

float MaxComponent(float3 v) { return max(v.x, max(v.y, v.z)); }

float3 LinearToSRGB(float3 c)
{
    return pow(c, 1.0 / 2.2);
}

float3 Shade(inout Ray ray, inout RayHit hit)
{
    if (hit.distance < 1.#INF)
    {
        if (hit.material.emissionIntensity > 0.0f)
        {
            hit.should_break = true;
            return hit.material.emission * hit.material.emissionIntensity; // Le
        }

        ray.origin = hit.position + hit.normal * 1e-4;
        float  xi      = RNG_Next(rng);
        float3 N       = hit.normal;
        float  rough   = hit.material.roughness;
        float3 albedo  = hit.material.albedo;
        float  metallic= hit.material.metallic;

        float3 specColor = lerp(float3(0.04,0.04,0.04), albedo, metallic);

        float  diffP = MaxComponent(albedo) * (1.0 - metallic);
        float  specP = MaxComponent(specColor);
        float  sumP  = diffP + specP;
        diffP /= sumP;
        specP /= sumP;

        if (xi < diffP)
        {
            ray.dir   = SampleHemisphere(N); // assume cosine weighted
            ray.color *= albedo / diffP;     // BRDF*cos/pdf = albedo
        }
        else
        {
            float3 refl = reflect(ray.dir, N);
            float3 jitter= SampleHemisphere(N);
            ray.dir     = normalize(lerp(refl, jitter, rough));
            ray.color  *= specColor / specP; // maintain color tint
        }

        return 0.0;
    }

    hit.should_break = true;
    return SampleSkybox(ray);
}

[numthreads(8,8,1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    RNG_SeedPixel(rng, id.xy, _FrameCount);

    Ray   r        = GenRayByID(id.xy);
    _Pixel         = id.xy;
    float3 result  = 0;

    for (int bounce = 0; bounce < _TraceDepth; ++bounce)
    {
        RayHit hit = Trace(r);

        if (_OnlyDrawAlbedo)
        { _Result[id.xy] = float4(hit.material.albedo,1); return; }
        if (_OnlyDrawDepth)
        { float nd=hit.distance/_CameraFar; _Result[id.xy]=float4(nd,nd,nd,1); return; }
        if (_OnlyDrawNormals)
        { _Result[id.xy] = float4(hit.normal*0.5+0.5,1); return; }

        float3 Le = Shade(r, hit);
        result   += r.color * Le;

        if (hit.should_break) break;

        if (bounce >= 2)
        {
            float q = MaxComponent(r.color);
            if (RNG_Next(rng) >= q) break;
            r.color *= 1.0 / q;
        }

        r.invDir = 1.0 / r.dir;
    }

    if (!_OnlyDrawNormals && !_OnlyDrawDepth && !_OnlyDrawAlbedo)
    {
        _Result[id.xy] = float4(result, 1);
    }
}