RWStructuredBuffer<HitData> PrimarySurfaceHistoryPrevRW;

[numthreads(64, 1, 1)]
void kernel_clear_restir_telemetry(uint3 id : SV_DispatchThreadID)
{
#if defined(RESTIR_TELEMETRY_ENABLED)
    if (id.x < RESTIR_TELEMETRY_PACKET_WORDS)
        ReSTIRTelemetry.Store(RestirTelemetryByteOffset(id.x), 0u);

    GroupMemoryBarrierWithGroupSync();
    if (id.x != 0u)
        return;

    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_MAGIC), RESTIR_TELEMETRY_MAGIC);
    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_SCHEMA), RESTIR_TELEMETRY_SCHEMA);
    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_FRAME), _FrameCount);
    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_SAMPLE), _RestirTelemetrySampleCount);
    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_GENERATION), _RestirTelemetryGeneration);
    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_WIDTH), _ScreenWidth);
    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_HEIGHT), _ScreenHeight);
    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_MODE_FLAGS), _RestirTelemetryModeFlags);
    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_DIRECT_INITIAL_SLOT), _RestirTelemetryDirectInitialSlot);
    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_DIRECT_FINAL_SLOT), _RestirTelemetryDirectFinalSlot);
    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_INDIRECT_INITIAL_SLOT), _RestirTelemetryIndirectInitialSlot);
    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_INDIRECT_FINAL_SLOT), _RestirTelemetryIndirectFinalSlot);
    ReSTIRTelemetry.Store(RestirTelemetryByteOffset(RESTIR_HEADER_SELECTED_PIXEL), _RestirTelemetrySelectedPixelIndex);
#endif
}

[numthreads(64, 1, 1)]
void kernel_capture_restir_frame(uint3 id : SV_DispatchThreadID)
{
#if defined(RESTIR_TELEMETRY_ENABLED)
    uint pixelCount = _ScreenWidth * _ScreenHeight;
    if (id.x >= pixelCount || id.x != RestirTelemetrySelectedPixel())
        return;

    float3 frameRadiance = GlobalColors[id.x].L;
    float frameLuminance = dot(max(frameRadiance, 0.0), float3(0.2126, 0.7152, 0.0722));
    static const uint gridSize = 4u;
    float gridLuminanceSum = 0.0;
    float gridLuminanceMax = 0.0;
    uint gridPositiveCount = 0u;
    bool gridFinite = true;
    [unroll]
    for (uint gridY = 0u; gridY < gridSize; gridY++)
    {
        [unroll]
        for (uint gridX = 0u; gridX < gridSize; gridX++)
        {
            uint sampleX = min(((2u * gridX + 1u) * _ScreenWidth) / (2u * gridSize), _ScreenWidth - 1u);
            uint sampleY = min(((2u * gridY + 1u) * _ScreenHeight) / (2u * gridSize), _ScreenHeight - 1u);
            float3 sampleRadiance = GlobalColors[sampleY * _ScreenWidth + sampleX].L;
            bool sampleFinite = all(isfinite(sampleRadiance));
            gridFinite = gridFinite && sampleFinite;
            float sampleLuminance = sampleFinite
                ? dot(max(sampleRadiance, 0.0), float3(0.2126, 0.7152, 0.0722))
                : 0.0;
            gridLuminanceSum += sampleLuminance;
            gridLuminanceMax = max(gridLuminanceMax, sampleLuminance);
            gridPositiveCount += sampleLuminance > 0.0 ? 1u : 0u;
        }
    }
    float gridSampleCount = (float)(gridSize * gridSize);
    RestirTelemetryWriteRecord(
        8u,
        RESTIR_STAGE_FRAME_OUTPUT,
        all(isfinite(frameRadiance)) && gridFinite ? RESTIR_REASON_NONE : RESTIR_REASON_NONFINITE_CONTRIBUTION,
        id.x,
        float4(frameRadiance, frameLuminance),
        float4(
            (float)_RestirTelemetryModeFlags,
            gridLuminanceSum / gridSampleCount,
            gridLuminanceMax,
            (float)gridPositiveCount / gridSampleCount),
        0.0,
        0.0,
        0.0,
        0.0);
#endif
}

// ==================== Kernel 0: Generate Primary Rays ====================

[numthreads(64, 1, 1)]
void kernel_generate(uint3 id : SV_DispatchThreadID)
{
    uint pixelCount = _ScreenWidth * _ScreenHeight;
    if (id.x >= pixelCount) return;

    uint2 pixel = uint2(id.x % _ScreenWidth, id.x / _ScreenWidth);

    // Use global rng so that Trace() -> SkipTransparent() etc. work correctly
    RNG_SeedPixel(rng, pixel, _FrameCount);

    float2 jitter = float2(RNG_Next(rng), RNG_Next(rng)) - 0.5;
    Ray r = GenRayByID((float2)pixel + jitter);

    RayData rd;
    rd.origin = r.origin;
    rd.direction = r.dir;
    rd.pixelIndex = id.x;
    rd.rngState = rng.state;
    rd.throughput = float3(1, 1, 1);
    rd.lastPdf = 0;

    GlobalRays[id.x] = rd;
    GlobalColors[id.x].L = float3(0, 0, 0);
    GlobalColors[id.x].throughput = float3(1, 1, 1);
    GlobalHits[id.x].distance = 1.#INF;
    PrimarySurfaceHistory[id.x] = GenHitData();

    // Debug modes: write debug color to GlobalColors (finalize kernel will output it)
    if (_OnlyDrawAlbedo || _OnlyDrawDepth || _OnlyDrawNormals)
    {
        _Pixel = pixel;
        RayHit firstHit = Trace(r);

        if (_OnlyDrawAlbedo)
            GlobalColors[id.x].L = firstHit.material.albedo;
        else if (_OnlyDrawDepth)
        {
            float nd = firstHit.distance / _CameraFar;
            GlobalColors[id.x].L = float3(nd, nd, nd);
        }
        else if (_OnlyDrawNormals)
            GlobalColors[id.x].L = firstHit.normal * 0.5f + 0.5f;

        // Mark this ray as terminated (no bounce processing needed)
        GlobalRays[id.x].throughput = float3(0, 0, 0);
    }
}

// ==================== Kernel 1: Trace (find closest intersection) ====================

[numthreads(64, 1, 1)]
void kernel_trace(uint3 id : SV_DispatchThreadID)
{
    int rayCount = BufferSizes[CurBounce].traceRays;
    if (rayCount <= 0 || id.x >= (uint)rayCount) return;

    RayData rd = GlobalRays[id.x];
    if (rd.throughput.x <= 0 && rd.throughput.y <= 0 && rd.throughput.z <= 0) return;

    rng.state = rd.rngState;
    _Pixel = uint2(rd.pixelIndex % _ScreenWidth, rd.pixelIndex / _ScreenWidth);

    Ray ray;
    ray.origin = rd.origin;
    ray.dir = rd.direction;
    ray.invDir = 1.0 / ray.dir;

    RayHit hit = Trace(ray);

    HitData hd;
    hd.position = hit.position;
    hd.distance = hit.distance;
    hd.normal = hit.normal;
    hd.mode = hit.mode;
    hd.albedo = hit.material.albedo;
    hd.emission = hit.material.emission;
    hd.emissionIntensity = hit.material.emissionIntensity;
    hd.roughness = hit.material.roughness;
    hd.metallic = hit.material.metallic;
    hd.alpha = hit.material.alpha;
    hd.ior = hit.material.ior;
    GlobalHits[id.x] = hd;
}

// ==================== Kernel 2: Shade (evaluate material + generate shadow rays) ====================

[numthreads(64, 1, 1)]
void kernel_shade(uint3 id : SV_DispatchThreadID)
{
    int rayCount = BufferSizes[CurBounce].traceRays;
    if (rayCount <= 0 || id.x >= (uint)rayCount) return;

    RayData rd = ShadeRays[id.x];
    if (rd.throughput.x <= 0 && rd.throughput.y <= 0 && rd.throughput.z <= 0) return;

    rng.state = rd.rngState;
    _Pixel = uint2(rd.pixelIndex % _ScreenWidth, rd.pixelIndex / _ScreenWidth);

    HitData hd = ShadeHits[id.x];
    float3 throughput = rd.throughput;
    float3 L = GlobalColors[rd.pixelIndex].L;
    // ReSTIR GI estimates the local radiance reached by the primary BSDF sample.
    // The wavefront path still crosses that vertex so it can continue at bounce 2+,
    // but must not add the same sky/emission/direct-light terms a second time.
    bool restirGIReplacesLocalShading = _UseReSTIRGI && CurBounce == 1;

    // Miss → skybox
    if (hd.distance >= 1.#INF)
    {
        if (!restirGIReplacesLocalShading)
        {
            Ray ray;
            ray.origin = rd.origin;
            ray.dir = rd.direction;
            ray.invDir = 1.0 / ray.dir;
            L += throughput * SampleSkybox(ray);
        }
        GlobalColors[rd.pixelIndex].L = L;
        return;
    }

    // Reconstruct RayHit for BXDF functions
    RayHit hit;
    hit.position = hd.position;
    hit.distance = hd.distance;
    hit.normal = hd.normal;
    hit.mode = hd.mode;
    hit.material.albedo = hd.albedo;
    hit.material.emission = hd.emission;
    hit.material.emissionIntensity = hd.emissionIntensity;
    hit.material.roughness = hd.roughness;
    hit.material.metallic = hd.metallic;
    hit.material.alpha = hd.alpha;
    hit.material.ior = hd.ior;
    hit.should_break = false;

    if (CurBounce == 0)
        PrimarySurfaceHistory[rd.pixelIndex] = hd;

    // Emission
    if (!restirGIReplacesLocalShading && hit.material.emissionIntensity > 0.0f)
        L += throughput * (hit.material.emission * hit.material.emissionIntensity);

    // Wavefront direct lighting: shade samples a light candidate and queues a shadow ray.
    // The shadow kernel is the only stage that resolves visibility and commits the contribution.
    if (!restirGIReplacesLocalShading && (!_UseReSTIRDI || CurBounce > 0))
        GenerateShadowRays(hit, -rd.direction, throughput, rd.pixelIndex);

    // BXDF sampling
    Ray ray;
    ray.origin = rd.origin;
    ray.dir = rd.direction;
    ray.invDir = 1.0 / ray.dir;
    float3 f_brdf;
    EvaluateBXDFWithDotAndPDF(hit, /*inout*/ ray, f_brdf);
    throughput *= f_brdf;

    // Russian Roulette
    float p = max(throughput.r, max(throughput.g, throughput.b));
    if (RNG_Next(rng) >= p)
    {
        GlobalColors[rd.pixelIndex].L = L;
        return;
    }
    throughput *= 1.0 / p;

    GlobalColors[rd.pixelIndex].L = L;

    // Write next-bounce ray
    ray.invDir = 1.0 / ray.dir;
    ray.origin = hit.position + hit.normal * 1e-5;

    uint nextIndex;
    InterlockedAdd(BufferSizes[CurBounce + 1].traceRays, 1, nextIndex);

    RayData nextRd;
    nextRd.origin = ray.origin;
    nextRd.direction = ray.dir;
    nextRd.pixelIndex = rd.pixelIndex;
    nextRd.rngState = rng.state;
    nextRd.throughput = throughput;
    nextRd.lastPdf = 0;
    GlobalRays2[nextIndex] = nextRd;
}

// ==================== Kernel 3: Shadow (trace shadow rays) ====================

[numthreads(64, 1, 1)]
void kernel_shadow(uint3 id : SV_DispatchThreadID)
{
    int shadowCount = BufferSizes[CurBounce].shadowRays;
    if (shadowCount <= 0 || id.x >= (uint)shadowCount) return;

    ShadowRayData sr = ShadowRaysBuffer[id.x];

    Ray ray;
    ray.origin = sr.origin;
    ray.dir = sr.direction;
    ray.invDir = 1.0 / ray.dir;

    if (IntersectTlasFast(ray, sr.maxDist))
        return;

    GlobalColors[sr.pixelIndex].L += sr.illumination;
}

// ==================== Kernel 4: Finalize ====================

[numthreads(8, 8, 1)]
void kernel_finalize(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _ScreenWidth || id.y >= _ScreenHeight) return;
    uint pixelIndex = id.y * _ScreenWidth + id.x;
    _Result[id.xy] = float4(GlobalColors[pixelIndex].L, 1.0f);
}

[numthreads(64, 1, 1)]
void kernel_copy_primary_surface_history(uint3 id : SV_DispatchThreadID)
{
    uint pixelCount = _ScreenWidth * _ScreenHeight;
    if (id.x >= pixelCount) return;

    PrimarySurfaceHistoryPrevRW[id.x] = PrimarySurfaceHistory[id.x];
}

// ==================== Kernel 5: Transfer (compute indirect dispatch args) ====================

int Type = 0; // 0=trace, 1=shadow

[numthreads(1, 1, 1)]
void TransferKernel(uint3 id : SV_DispatchThreadID)
{
    if (Type == 0)
    {
        uint count = (uint)max(BufferSizes[CurBounce].traceRays, 0);
        IndirectArgs[0] = (count + 63) / 64;
        IndirectArgs[1] = 1;
        IndirectArgs[2] = 1;
    }
    else
    {
        uint count = (uint)max(BufferSizes[CurBounce].shadowRays, 0);
        IndirectArgs[0] = (count + 63) / 64;
        IndirectArgs[1] = 1;
        IndirectArgs[2] = 1;
    }
}
