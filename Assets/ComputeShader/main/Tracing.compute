#pragma kernel CSMain

#include "function.hlsl"
#include "colors.hlsl"
#include "bxdf.hlsl"
#include "test.hlsl"
#include "trace.hlsl"

float3 Shade(Ray ray)
{
    float3 throughput = 1.0;
    float3 L_Contribution          = 0.0;

    for (int bounce = 0; bounce < _TraceDepth; ++bounce)
    {
        RayHit hit = Trace(ray);
        if (hit.distance >= 1.#INF)
        {
            L_Contribution += throughput * SampleSkybox(ray);
            break;
        }
        if (hit.material.emissionIntensity > 0.0f)
        {
            L_Contribution += throughput * (hit.material.emission * hit.material.emissionIntensity);
            break;
        }

        float roulette = RNG_Next(rng);
        float3 V = -ray.dir;
        float3 Lo_direct = GetLightContribution(hit);
        L_Contribution += throughput * Lo_direct;
        
        if (hit.mode >= 3.0)
        {
            if (dot(ray.dir, hit.normal) > 0.0)
                hit.normal = -hit.normal;
            // dielectric workflow
            float alpha = SmoothnessToPhongAlpha(hit.material.roughness);
            hit.normal = normalize(lerp(
                hit.normal,
                SampleReflectionDirectionSphere(hit.normal,alpha),
                hit.material.roughness * hit.material.roughness
            ));
            float3 rayOutDir = normalize(reflect(ray.dir, hit.normal));
            float3 H = normalize(V + rayOutDir);
            float fresnel = DielectricFresnel(dot(H, V), hit.material.ior);
            float reflChance = 1.0 - (1.0 - fresnel) * (1.0 - hit.material.metallic);
            if (roulette < reflChance)
            {
                float3 brdfCos;
                float  microPdf;
                SpecReflModel(hit, V, rayOutDir, H, brdfCos, microPdf);
                float pdf = reflChance * microPdf;
                ray.dir = rayOutDir;
                float NdotL = saturate(dot(hit.normal, rayOutDir));
                throughput *= brdfCos * NdotL / pdf;
            }
            else
            {
                rayOutDir = normalize(refract(ray.dir, hit.normal, 1.0 / hit.material.ior));
                SpecRefrModel(hit, V, rayOutDir, H, throughput);
                ray.dir = rayOutDir;
                throughput *= 1.0 / clamp((1.0 - reflChance), 1e-2, 1.0);
            }
        }
        else
        {
            float3 F0 = lerp(float3(0.04,0.04,0.04), hit.material.albedo, hit.material.metallic);
            float  specProb = saturate(max(max(F0.x, F0.y), F0.z));
            float  diffProb = 1.0 - specProb;
            // Calculate chances of diffuse and specular reflection
            if (roulette < specProb)
            {
                float alpha = hit.material.roughness * hit.material.roughness;
                float2 xi = float2(RNG_Next(rng), RNG_Next(rng));
                float3 H = SampleGGXVNDF(hit.normal, V, alpha, xi);
                float3 rayOutDir = normalize(reflect(-V, H));

                float3 f_brdf;
                float microPdf;
                SpecReflModel(hit, V, rayOutDir, H, f_brdf, microPdf);
                float pdf = max(specProb * microPdf, 1e-4);
                float NdotL = saturate(dot(hit.normal, rayOutDir));
                throughput *= f_brdf * NdotL / pdf;

                ray.dir = rayOutDir;
            }
            else
            {
                float3 rayOutDir = normalize(SampleHemisphere(hit.normal));

                float NdotL      = saturate(dot(hit.normal, rayOutDir));
                float diffusePdf = NdotL / PI;

                float3 f_diffuse = hit.material.albedo / PI;
                float pdf = max(diffusePdf * diffProb, 1e-4);
                throughput *= f_diffuse * NdotL / pdf;

                ray.dir = rayOutDir;
            }
        }

        float p = max(throughput.r, max(throughput.g, throughput.b));
        if (RNG_Next(rng) >= p)
            break;
        throughput *= 1.0 / p;
        ray.invDir = 1.0 / ray.dir;
        ray.origin = hit.position + hit.normal * 1e-5;
    }
    return L_Contribution;
}

[numthreads(8,8,1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    RNG_SeedPixel(rng, id.xy, _FrameCount);
    Ray r = GenRayByID(id.xy);
    _Pixel = id.xy;
    
    if (_OnlyDrawAlbedo || _OnlyDrawDepth || _OnlyDrawNormals)
    {
        RayHit firstHit = Trace(r);

        if (_OnlyDrawAlbedo)
            _Result[id.xy] = float4(firstHit.material.albedo, 1.0f);

        else if (_OnlyDrawDepth)
        {
            float nd = firstHit.distance / _CameraFar;
            _Result[id.xy] = float4(nd, nd, nd, 1.0f);
        }
        else if (_OnlyDrawNormals)
            _Result[id.xy] = float4(firstHit.normal * 0.5f + 0.5f, 1.0f);

        return;
    }

    float3 L = Shade(r);
    _Result[id.xy] = float4(L, 1.0f);
}

